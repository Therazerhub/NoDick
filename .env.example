# NoDick Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMIN_ID=123456789

# Telethon user session (for /import history indexing)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_PHONE=+910****0000
TELEGRAM_USER_SESSION=runtime/nodick_user
IMPORT_CHANNEL_ID=-1001234567890

# Database
DB_PATH=runtime/nodick.db
BOT_USERNAME=Moyechan_bot

# Metadata APIs
STASHDB_API_KEY=your_stashdb_api_key_here
STASHDB_GRAPHQL_URL=https://stashdb.org/graphql
FANSDB_API_KEY=
FANSDB_GRAPHQL_URL=https://fansdb.cc/graphql

# Optional 1-day sponsored Premium passes (disabled until domain + key exist).
# Use a provider that permits your destination content AND rewarded visits.
# Compatible with GET /api?api=<key>&url=<destination>, JSON shortenedUrl.
SHORTENER_DOMAIN=
SHORTENER_API_KEY=
SHORTENER_ENABLED=true
# Optional: upload tutorial via Settings -> Sponsor Pass, or set video URL/file ID.
SHORTENER_TUTORIAL_VIDEO=
# Advanced compatibility overrides (not every shortener uses this protocol).
SHORTENER_API_PATH=/api
SHORTENER_API_PARAM=api
SHORTENER_URL_PARAM=url
SHORTENER_URL_FIELD=shortenedUrl
# Comma-separated exact returned-link hosts if different from SHORTENER_DOMAIN.
SHORTENER_LINK_DOMAINS=

# Matching
MATCH_THRESHOLD=0.0           # 0.0 = no filtering, 0.8 = 80% threshold
AUTO_RENAME_THRESHOLD=0.90    # Auto-rename at 90%+ confidence
DEBUG_MATCHING=false

# Logging
LOG_LEVEL=INFO
LOGS_CHANNEL_ID=0
